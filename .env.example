# Copier ce fichier en .env puis choisir UN des trois profils ci-dessous.
#   cp .env.example .env

# ============================================================================
# PROFIL A — 100 % local et gratuit avec Ollama (Llama 3.1 + bge-m3)
#   1. Installer Ollama : https://ollama.com
#   2. ollama pull qwen2.5:3b && ollama pull bge-m3
#
# Choix du modèle selon la mémoire de la carte graphique (mesuré sur RTX 3050 4 Go) :
#   - qwen2.5:3b  (~2 Go) : tient entièrement dans 4 Go → ~30 s par question  ← défaut
#   - llama3.1:8b (~6 Go) : 64 % sur CPU avec 4 Go → ~140 s par question ; à préférer
#     avec 8 Go de VRAM ou plus (meilleur suivi des consignes)
# ============================================================================
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Ollama sur votre machine, vu depuis Docker :
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Hors Docker (uvicorn lancé à la main) : OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# PROFIL B — Claude (meilleure qualité de réponse) + embeddings locaux Ollama
# ============================================================================
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=votre_cle_ici
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# ============================================================================
# PROFIL C — Démo sans aucun modèle (tester l'interface et l'ingestion)
#   Les « réponses » recopient le meilleur passage trouvé.
# ============================================================================
# LLM_PROVIDER=fake
# EMBEDDING_PROVIDER=hash
# EMBEDDING_DIM=1024

# ----------------------------------------------------------------------------
# Réglages communs (valeurs par défaut raisonnables)
# ----------------------------------------------------------------------------
CHUNK_STRATEGY=article          # article | fixed
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_MODE=hybrid           # hybrid | vector | fulltext (comparaisons)
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=6
RERANKER=none                   # none | cross_encoder (nécessite LOCAL_MODELS=1)
AGENT_MAX_REWRITES=2
EMBED_BATCH_SIZE=32
WORKER_CONCURRENCY=2
LOG_LEVEL=INFO

# Langfuse (optionnel) : https://cloud.langfuse.com → Settings → API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
